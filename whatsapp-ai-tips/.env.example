# Twilio credentials — get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp-enabled number (without the "whatsapp:" prefix)
# For the Sandbox this is usually: +14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886

# Time to send daily tips (UTC, 24-hour clock)
DAILY_SEND_HOUR=9
DAILY_SEND_MINUTE=0

# Port for the Express server
PORT=3000
